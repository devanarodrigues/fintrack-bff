# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS POSTGRESQL
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais reais

# Host do banco de dados (use 'localhost' se estiver rodando localmente)
DB_HOST=localhost

# Porta do PostgreSQL (padrão: 5432)
DB_PORT=5432

# Nome do banco de dados (será criado se não existir)
DB_NAME=fintrack

# Usuário do PostgreSQL
DB_USER=postgres

# Senha do PostgreSQL
DB_PASSWORD=sua_senha_aqui

# ============================================
# CONFIGURAÇÕES DA API
# ============================================
# Host onde a API vai rodar (0.0.0.0 para aceitar conexões externas)
API_HOST=0.0.0.0

# Porta da API
API_PORT=5000

# Modo debug (True para desenvolvimento, False para produção)
DEBUG=True

# ============================================
# CONFIGURAÇÕES DE UPLOAD
# ============================================
# Pasta onde os arquivos PDF serão temporariamente salvos
UPLOAD_FOLDER=./uploads

# ============================================
# CONFIGURAÇÕES DE OCR
# ============================================
# Habilitar processamento OCR de PDFs
OCR_ENABLED=True
