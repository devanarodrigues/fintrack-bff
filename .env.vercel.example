# ============================================
# VARIÁVEIS DE AMBIENTE PARA VERCEL
# FinTrack BFF - Backend for Frontend
# ============================================
# 
# Estas variáveis devem ser configuradas no painel da Vercel:
# Settings > Environment Variables
#
# ============================================

# ============================================
# CONFIGURAÇÕES DO BANCO DE DADOS POSTGRESQL
# ============================================
# Para produção na Vercel, use um banco PostgreSQL gerenciado como:
# - Supabase (recomendado - gratuito)
# - Neon (gratuito)
# - Railway
# - Heroku PostgreSQL

# URL completa do banco de dados (formato PostgreSQL)
# Exemplo Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:port/database

# Ou configure as variáveis individuais:
DB_HOST=your-db-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-secure-password

# ============================================
# CONFIGURAÇÕES DE OCR
# ============================================
OCR_ENABLED=True

# ============================================
# NOTAS IMPORTANTES PARA VERCEL
# ============================================
# 1. A Vercel injeta automaticamente a variável VERCEL=1
# 2. Use /tmp para arquivos temporários (único diretório gravável)
# 3. Não inclua app.run() no código (a Vercel gerencia a execução)
# 4. Configure o runtime Python no vercel.json
# 5. Para banco de dados, considere usar Supabase (gratuito e fácil)
